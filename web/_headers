# eden64 — en-têtes Netlify (lus aussi par les déploiements glisser-déposer)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: gamepad=(self), fullscreen=(self), autoplay=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/emulator/data/cores/*
  Cache-Control: public, max-age=604800

/cheats/*
  Cache-Control: public, max-age=86400

/*.wasm
  Content-Type: application/wasm

/manifest.webmanifest
  Content-Type: application/manifest+json

/icons/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Content-Type: image/svg+xml
